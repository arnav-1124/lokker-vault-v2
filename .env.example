# Lokker environment configuration
# Copy this file to .env.local for local development (.env* is gitignored
# except this example). Production values are set in the host's environment
# settings (e.g. Vercel project environment variables).

# Public origin of the deployed web app, no trailing slash.
# Local development keeps the http://localhost:3000 fallback in src/config/app.ts.
NEXT_PUBLIC_APP_URL=http://localhost:3000
